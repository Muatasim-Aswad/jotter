{
  "name": "@jotter/protocol",
  "version": "1.0.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./content": {
      "types": "./src/content.ts",
      "default": "./src/content.ts"
    }
  },
  "scripts": {
    "format": "oxfmt --write src tests '!src/validators.js'",
    "format:check": "oxfmt --check src tests '!src/validators.js'",
    "lint": "oxlint src tests --ignore-pattern src/validators.js",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muatasim-Aswad/jotter.git"
  },
  "homepage": "https://github.com/Muatasim-Aswad/jotter"
}
