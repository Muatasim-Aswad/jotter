# Optional: save as .env beside compose.yaml and protect with mode 0600.
JOTTER_HOST_PORT=8080
JOTTER_PUBLIC_ORIGIN=https://jotter.example
JOTTER_LOG_LEVEL=info
# Optional: select a verified published image digest instead of the version tag.
# JOTTER_IMAGE=ghcr.io/muatasim-aswad/jotter@sha256:<verified-digest>
# For a locally built image, use JOTTER_IMAGE=jotter:local.
