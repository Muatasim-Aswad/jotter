{
  "name": "@jotter/web",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build && node ../../scripts/release/web-notices.mjs",
    "dev": "vite --host 127.0.0.1",
    "format": "oxfmt --write index.html src tests vite.config.ts build-info.ts playwright.config.ts",
    "format:check": "oxfmt --check index.html src tests vite.config.ts build-info.ts playwright.config.ts",
    "lint": "oxlint --deny-warnings src tests vite.config.ts build-info.ts playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:unit": "vitest run src tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jotter/protocol": "workspace:*",
    "idb": "8.0.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muatasim-Aswad/jotter.git"
  },
  "homepage": "https://github.com/Muatasim-Aswad/jotter"
}
